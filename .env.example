# All keys are OPTIONAL. Participants can also paste their own (BYOK) in the app's Settings page.

# Groq powers the AI assistant (LangGraph) and the "Simulated Bedrock" sandbox engine.
GROQ_API_KEY=

# Live Amazon Bedrock mode for the sandbox. Leave empty to use the default AWS credential chain
# (env vars, ~/.aws/credentials, SSO, instance role...).
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
